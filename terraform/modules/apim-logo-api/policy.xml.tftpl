<policies>
  <inbound>
    <base />
%{ if front_door_id != null ~}
    <!-- Additional origin validation; private ingress is finalized separately. -->
    <check-header name="X-Azure-FDID" failed-check-httpcode="403" failed-check-error-message="Use the configured Front Door endpoint." ignore-case="false"><value>${front_door_id}</value></check-header>
%{ endif ~}
    <set-backend-service base-url="https://${function_hostname}" />
    <!-- Preserve both public path aliases and all query parameters, including explicit. -->
    <rewrite-uri template="@(context.Request.OriginalUrl.Path)" copy-unmatched-params="true" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="x-functions-key" exists-action="delete" />
    <authentication-managed-identity resource="${audience}" ignore-error="false" />
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /><set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header></on-error>
</policies>
